---
import Layout from '../layouts/Layout.astro';
import CtaButton from '../components/CtaButton.astro';
import CallLink from '../components/CallLink.astro';
import Icon from '../components/Icon.astro';
import Reviews from '../components/Reviews.astro';
import CrossLinks from '../components/CrossLinks.astro';
import { IMG, PARTNERS } from '../data/images';
import { pathFor } from '../data/site';

const lang = 'fr' as const;

const offers = [
  {
    img: IMG.cardEntreprise,
    alt: "Groupe en sortie guidée sur un sentier fleuri au-dessus de Verbier",
    eyebrow: 'De mai à octobre · clé en main',
    title: "Sortie d'Entreprise",
    items: ['Sortie d’entreprise en E-bike', 'Découverte des produits du terroir', 'Visite des restaurateurs locaux'],
    cta: 'Info et Tarifs',
    href: pathFor('entreprise', lang),
  },
  {
    img: IMG.cardGuide,
    alt: 'Sortie VTT guidée sur une piste aménagée à Verbier',
    eyebrow: 'Dès 80.- la demi-journée',
    title: 'Guide Privé / Rando Gourmande',
    items: ['De débutant à expert', 'Parfait pour les familles', 'En E-bike ou Enduro'],
    cta: 'Découvrir',
    href: pathFor('guide', lang),
  },
  {
    img: IMG.heroEbike,
    alt: 'Trois riders en e-bike sur les hauteurs de Verbier',
    eyebrow: 'Tous niveaux',
    title: 'Sorties E-bike',
    items: ["Chemins d'alpage du Val de Bagnes", 'Rando gourmande en cabane', 'Balade tranquille ou grand tour sportif'],
    cta: 'Découvrir',
    href: pathFor('ebike', lang),
  },
  {
    img: IMG.cardSemaine,
    alt: 'Rider en plein virage relevé pendant un cours de VTT à Verbier',
    eyebrow: 'Adultes & enfants',
    title: 'Cours Privés VTT',
    items: ['Position, virages, freinage', 'Du débutant au pilote confirmé', 'Avec un moniteur né à Verbier'],
    cta: 'Découvrir',
    href: pathFor('cours', lang),
  },
  {
    img: IMG.cardNepal,
    alt: 'Rider portant son vélo face aux sommets himalayens, Népal',
    eyebrow: 'Voyage d’une vie',
    title: '10 Jours d’enduro au Népal',
    items: ['Accueil local', 'Shuttle privé', 'Vols internes'],
    cta: 'Découvrir',
    href: pathFor('nepal', lang),
  },
];

// Compteurs : sources verbier4vallees.ch (500 km de parcours VTT, installations été 2026) et verbier.ch (restaurants d'altitude), relevées le 22.09.2026.
const counters = [
  { n: 12, label: "Restaurants d’altitude", icon: 'utensils' },
  { n: 500, label: 'km de parcours VTT', icon: 'route' },
  { n: 23, label: 'Itinéraires enduro balisés', icon: 'flag' },
  { n: 18, label: 'Remontées ouvertes en été', icon: 'gondola' },
];
---

<Layout
  lang={lang}
  routeKey="home"
  title="Guide VTT Verbier | E-bike, Enduro, Location & Bike Park | Bikeverbier.ch"
  description="Guides VTT et e-bike nés à Verbier : sorties guidées, rando gourmande, cours privés, location e-bike 125.- la journée, team building de mai à octobre."
  ogImage={IMG.ogHome}
  jsonLd={true}
>
  <section class="hero">
    <img class="hero__bg" src={IMG.heroHome} alt="VTT en descente sur les sentiers de Verbier" width="1920" height="1280" fetchpriority="high" />
    <div class="hero__inner container">
      <p class="eyebrow" style="color:#fff">Guides VTT à Verbier</p>
      <h1 class="h1" data-wipe>Découvrez le <span class="teal">Verbier caché</span></h1>
      <p class="lead">Guides VTT locaux, sorties e-bike et enduro : des sentiers reculés aux saveurs du terroir valaisan, laissez-vous porter par l'authenticité de nos guides nés à Verbier.</p>
      <div class="hero-actions"><CtaButton href={pathFor('contact', lang)} label="Let's go !" variant="light" /><CallLink /></div>
    </div>
  </section>

  <div class="sheet">
    <section class="section container">
      <div class="center" style="margin-bottom:2.5rem">
        <p class="eyebrow">Nos offres</p>
        <h2 class="h2">Sorties VTT et e-bike guidées à <span class="teal">Verbier</span></h2>
      </div>
      <div class="cards">
        {
          offers.map((o, i) => (
            <article class={`card ${i % 2 === 1 ? 'card--reverse' : ''}`} data-reveal>
              <img class="card__img" src={o.img} alt={o.alt} loading="lazy" />
              <div class="card__body">
                <p class="eyebrow">{o.eyebrow}</p>
                <h3 class="h3 teal">{o.title}</h3>
                <ul>{o.items.map((it) => <li>{it}</li>)}</ul>
                <CtaButton href={o.href} label={o.cta} variant="dark" />
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section--alt">
      <div class="container counters">
        {
          counters.map((c) => (
            <div data-reveal>
              <div class="counter__icon icon-badge"><Icon name={c.icon} size={26} /></div>
              <div class="counter__num"><span data-count={c.n}>{c.n}</span></div>
              <div class="counter__label">{c.label}</div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section container">
      <div class="card" data-reveal>
        <img class="card__img" src={IMG.welcome} alt="Guide Bikeverbier à Verbier" loading="lazy" />
        <div class="card__body">
          <p class="eyebrow">Bienvenue</p>
          <h2 class="h2">Bienvenue chez <span class="teal">Bikeverbier.ch</span> !</h2>
          <p class="lead">Nous sommes des guides tous nés à Verbier prêts à vous faire découvrir nos chemins et traditions locales !</p>
          <p style="color:var(--gray-text)">Votre <a href={pathFor('guide', lang)}>guide VTT local à Verbier</a> : sorties e-bike et enduro, randos gourmandes et <a href={pathFor('cours', lang)}>cours privés</a>, avec <a href={pathFor('location', lang)}>location e-bike</a> possible pour chaque sortie. Des sentiers moins fréquentés du Valais aux meilleures tables d'altitude, on partage notre montagne avec ceux qui veulent la vivre autrement. Envie de préparer votre séjour ? Parcourez notre <a href={pathFor('itineraires', lang)}>guide complet du VTT à Verbier</a>.</p>
          <CtaButton href={`${pathFor('contact', lang)}#guides`} label="Nos Guides" variant="teal" />
        </div>
      </div>
    </section>

    <Reviews lang={lang} alt />

    <CrossLinks
      lang={lang}
      links={[
        { href: pathFor('ebike', lang), label: 'Sorties e-bike guidées à Verbier' },
        { href: pathFor('itineraires', lang), label: 'VTT à Verbier : sentiers, bike park, saison' },
        { href: `${pathFor('itineraires', lang)}#bike-park`, label: "Bike park de Verbier : mode d'emploi" },
        { href: pathFor('location', lang), label: 'Location e-bike et VTT à Verbier' },
        { href: pathFor('entreprise', lang), label: 'Team building VTT et e-bike' },
        { href: pathFor('nepal', lang), label: 'Voyage enduro au Népal' },
      ]}
    />

    <section class="section">
      <div class="container">
        <p class="eyebrow center">Nos partenaires</p>
        <div class="partners" style="margin-top:2.5rem">
          {PARTNERS.map((p) => <img src={p.src} alt={p.name} title={p.name} loading="lazy" />)}
        </div>
      </div>
    </section>
  </div>
</Layout>
