---
import Layout from '../layouts/Layout.astro';
import CtaButton from '../components/CtaButton.astro';
import CallLink from '../components/CallLink.astro';
import Icon from '../components/Icon.astro';
import Reviews from '../components/Reviews.astro';
import { IMG, PARTNERS } from '../data/images';
import { pathFor } from '../data/site';

const lang = 'fr' as const;

const offers = [
  {
    img: IMG.cardEntreprise,
    alt: "Groupe en sortie guidée sur un sentier fleuri au-dessus de Verbier",
    eyebrow: 'Clé en main',
    title: "Sortie d'Entreprise",
    items: ['Sortie d’entreprise en E-bike', 'Découverte des produits du terroir', 'Visite des restaurateurs locaux'],
    cta: 'Info et Tarifs',
    href: pathFor('entreprise', lang),
  },
  {
    img: IMG.cardGuide,
    alt: 'Sortie VTT guidée sur une piste aménagée à Verbier',
    eyebrow: 'À partir de 120.-',
    title: 'Guide Privé / Rando Gourmande',
    items: ['De débutant à expert', 'Parfait pour les familles', 'En E-bike ou Enduro'],
    cta: 'Découvrir',
    href: pathFor('guide', lang),
  },
  {
    img: IMG.cardSemaine,
    alt: 'Rider en plein virage relevé pendant un cours de VTT à Verbier',
    eyebrow: 'Adultes & enfants',
    title: 'Cours Privés VTT',
    items: ['Position, virages, freinage', 'Du débutant au pilote confirmé', 'Avec un moniteur né à Verbier'],
    cta: 'Découvrir',
    href: pathFor('cours', lang),
  },
  {
    img: IMG.cardNepal,
    alt: 'Rider portant son vélo face aux sommets himalayens, Népal',
    eyebrow: 'Voyage d’une vie',
    title: '10 Jours d’enduro au Népal',
    items: ['Accueil local', 'Shuttle privé', 'Vols internes'],
    cta: 'Découvrir',
    href: pathFor('nepal', lang),
  },
];

// ⚠ Valeurs des compteurs à CONFIRMER avec Guillermo (0 sur le site Framer actuel).
const counters = [
  { n: 15, label: "Restaurants d’altitude", icon: 'utensils' },
  { n: 400, label: 'km de sentiers balisés', icon: 'route' },
  { n: 150, label: 'Jours de vélo par an', icon: 'sun' },
  { n: 30, label: 'Remontées mécaniques', icon: 'gondola' },
];
---

<Layout
  lang={lang}
  routeKey="home"
  title="#1 Guide VTT Verbier | E-bike, Enduro & Rando | Bikeverbier.ch"
  description="Guide VTT local à Verbier : sorties E-bike & enduro, rando gourmande, cours privés adultes et enfants, location e-bike. Vos guides nés à Verbier vous font découvrir les meilleurs sentiers du Valais."
  ogImage={IMG.ogHome}
  jsonLd={true}
>
  <section class="hero">
    <img class="hero__bg" src={IMG.heroHome} alt="VTT en descente sur les sentiers de Verbier" width="1920" height="1280" fetchpriority="high" />
    <div class="hero__inner container">
      <p class="eyebrow" style="color:#fff">Guides VTT à Verbier</p>
      <h1 class="h1" data-wipe>Découvrez le <span class="teal">Verbier caché</span></h1>
      <p class="lead">Guides VTT locaux, sorties e-bike et enduro : des sentiers secrets aux saveurs du terroir valaisan, laissez-vous porter par l'authenticité de nos guides nés à Verbier.</p>
      <div class="hero-actions"><CtaButton href={pathFor('contact', lang)} label="Let's go !" variant="light" /><CallLink /></div>
    </div>
  </section>

  <div class="sheet">
    <section class="section container">
      <div class="center" style="margin-bottom:2.5rem">
        <p class="eyebrow">Nos offres</p>
        <h2 class="h2">Sorties VTT et e-bike guidées à <span class="teal">Verbier</span></h2>
      </div>
      <div class="cards">
        {
          offers.map((o, i) => (
            <article class={`card ${i % 2 === 1 ? 'card--reverse' : ''}`} data-reveal>
              <img class="card__img" src={o.img} alt={o.alt} loading="lazy" />
              <div class="card__body">
                <p class="eyebrow">{o.eyebrow}</p>
                <h3 class="h3 teal">{o.title}</h3>
                <ul>{o.items.map((it) => <li>{it}</li>)}</ul>
                <CtaButton href={o.href} label={o.cta} variant="dark" />
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section--alt">
      <div class="container counters">
        {
          counters.map((c) => (
            <div data-reveal>
              <div class="counter__icon icon-badge"><Icon name={c.icon} size={26} /></div>
              <div class="counter__num"><span data-count={c.n}>0</span></div>
              <div class="counter__label">{c.label}</div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section container">
      <div class="card" data-reveal>
        <img class="card__img" src={IMG.welcome} alt="Guide Bikeverbier à Verbier" loading="lazy" />
        <div class="card__body">
          <p class="eyebrow">Bienvenue</p>
          <h2 class="h2">Bienvenue chez <span class="teal">Bikeverbier.ch</span> !</h2>
          <p class="lead">Nous sommes des guides tous nés à Verbier prêts à vous faire découvrir nos chemins et traditions locales !</p>
          <p style="color:var(--gray-text)">Votre <a href={pathFor('guide', lang)}>guide VTT local à Verbier</a> : sorties e-bike et enduro, randos gourmandes et <a href={pathFor('cours', lang)}>cours privés</a>, avec <a href={pathFor('location', lang)}>location e-bike</a> possible pour chaque sortie. Des sentiers secrets du Valais aux meilleures tables d'altitude, on partage notre montagne avec ceux qui veulent la vivre autrement. Envie de préparer votre séjour ? Parcourez notre <a href={pathFor('itineraires', lang)}>guide complet du VTT à Verbier</a>.</p>
          <CtaButton href={`${pathFor('contact', lang)}#guides`} label="Nos Guides" variant="teal" />
        </div>
      </div>
    </section>

    <Reviews lang={lang} alt />

    <section class="section">
      <div class="container">
        <p class="eyebrow center">Nos partenaires</p>
        <div class="partners" style="margin-top:2.5rem">
          {PARTNERS.map((p) => <img src={p.src} alt={p.name} title={p.name} loading="lazy" />)}
        </div>
      </div>
    </section>
  </div>
</Layout>
