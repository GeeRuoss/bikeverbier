---
import Layout from '../layouts/Layout.astro';
import CtaButton from '../components/CtaButton.astro';
import CallLink from '../components/CallLink.astro';
import CrossLinks from '../components/CrossLinks.astro';
import Icon from '../components/Icon.astro';
import Reviews from '../components/Reviews.astro';
import { IMG } from '../data/images';
import { SITE, pathFor } from '../data/site';

const lang = 'fr' as const;

// Prix CHF, IDENTIQUES en FR et EN (cf. README : bug de traduction Framer à ne pas reproduire).
const rows = [
  ['1 personne', '320.-', '550.-'],
  ['2 personnes', '195.-', '290.-'],
  ['3 personnes', '160.-', '220.-'],
  ['4 personnes', '120.-', '175.-'],
  ['5 personnes', '95.-', '145.-'],
  ['6 personnes', '80.-', '120.-'],
];

const features = [
  {
    img: IMG.cardGuide,
    icon: 'pin',
    eyebrow: 'Guides locaux',
    title: 'Nés à Verbier, on connaît chaque sentier',
    desc: 'On ne suit pas un itinéraire sur une carte : on partage les chemins de notre enfance. Des singletracks reculés aux descentes panoramiques du Valais, chaque sortie VTT est une vraie rencontre avec le terroir et ses adresses cachées.',
  },
  {
    img: IMG.welcome,
    icon: 'leaf',
    eyebrow: 'Respect & plaisir',
    title: 'À votre rythme, dans le respect de la montagne',
    desc: 'Débutant ou pilote confirmé, en e-bike ou en enduro, on adapte le terrain et le tempo à votre niveau. On roule propre, on respecte les sentiers et la nature, pour que le plaisir dure, sortie après sortie.',
  },
  {
    img: IMG.guideGourmande,
    icon: 'utensils',
    eyebrow: 'Rando gourmande',
    title: 'Rando gourmande : on pédale, on déguste !',
    desc: "On vous emmène sur les plus beaux sentiers de Verbier, puis on s'arrête dans une cabane ou un restaurant d'alpage pour goûter aux plats locaux. Assiette valaisanne, fromage d'alpage, pain de seigle : le terroir du Valais se mérite, et il se savoure encore mieux après l'effort !",
  },
];

// FAQ visible + balisage FAQPage : les questions telles qu'on les pose à Google et aux IA.
const faq = [
  {
    q: 'Combien coûte un guide VTT à Verbier ?',
    a: "De 80 à 320 CHF par personne pour une demi-journée et de 120 à 550 CHF pour une journée complète, selon la taille du groupe (1 à 6 personnes) : plus vous êtes nombreux, moins c'est cher. Le casque est offert et chaque sortie est privée et sur mesure.",
  },
  {
    q: 'Peut-on louer un e-bike ou un VTT pour la sortie ?',
    a: "Oui. La location coûte 125 CHF la journée : nous réservons pour vous le bon vélo chez nos partenaires de Verbier et il vous attend au départ de la sortie. Tous les détails sont sur notre page location e-bike Verbier.",
  },
  {
    q: 'Quel niveau faut-il pour une sortie guidée ?',
    a: "Aucun prérequis : du grand débutant au pilote confirmé, en e-bike ou en enduro, on adapte l'itinéraire et le rythme à votre niveau. Les familles avec enfants sont les bienvenues.",
  },
  {
    q: 'Quand peut-on faire du VTT à Verbier ?',
    a: "La saison s'étend en général de mai à octobre selon l'enneigement, avec les remontées mécaniques ouvertes en été. Avec environ 150 jours de vélo par an, il y a presque toujours un sentier rideable : nos guides savent où.",
  },
  {
    q: "La rando gourmande, c'est quoi exactement ?",
    a: "Une sortie VTT ou e-bike qui se termine dans une cabane ou un restaurant d'alpage : assiette valaisanne, fromage d'alpage, pain de seigle. On pédale, puis on déguste les produits du terroir du Valais.",
  },
  {
    q: 'En quelles langues les sorties sont-elles guidées ?',
    a: 'Nos guides parlent français, anglais, espagnol et allemand. Tous sont nés à Verbier et certifiés Swiss Cycling.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  lang={lang}
  routeKey="guide"
  title="Guide VTT à Verbier | Sorties E-bike & Enduro avec des locaux | Bike Verbier"
  description="Le meilleur guide VTT de Verbier : sorties guidées, randos gourmandes avec dégustation de plats locaux du Valais, coaching privé. Guides nés à Verbier, e-bike ou enduro, tous niveaux. Location et organisation incluses."
  ogImage={IMG.heroGuide}
>
  <section class="hero">
    <img class="hero__bg" src={IMG.heroGuide} alt="Sortie VTT guidée à Verbier avec un guide local" width="1920" height="1280" fetchpriority="high" />
    <div class="hero__inner container">
      <p class="eyebrow" style="color:#fff">Guide privé · Rando gourmande</p>
      <h1 class="h1" data-wipe>Votre guide VTT sur les plus beaux <span class="teal">chemins de Verbier</span> !</h1>
      <p class="lead">Profitez de l'air pur de Verbier à votre niveau, avec des guides locaux.</p>
      <div class="hero-actions"><CtaButton href={SITE.whatsapp} label="C'est parti !" variant="light" external /><CallLink /></div>
    </div>
  </section>

  <div class="sheet">
    <section class="section section--intro container center">
      <p class="eyebrow">Guide VTT Verbier</p>
      <h2 class="h2">Le Verbier des <span class="teal">locaux</span>, à vélo</h2>
      <p class="lead measure" style="margin:1.25rem auto 0">
        Nés et grandis à Verbier, nous connaissons chaque sentier du Valais, des chemins reculés aux descentes à couper le souffle. En e-bike ou en enduro, pour débutants comme experts, on vous fait découvrir notre montagne avec respect et plaisir.
      </p>
      <p class="measure" style="margin:1rem auto 0; color:var(--gray-text)">
        Faites connaissance avec <a href={`${pathFor('contact', lang)}#guides`}>nos guides certifiés Swiss Cycling</a> ou préparez votre venue avec notre <a href={pathFor('itineraires', lang)}>guide du VTT à Verbier</a>.
      </p>
    </section>

    <section class="section container">
      <div class="cards">
        {
          features.map((f, i) => (
            <article class={`card ${i % 2 === 1 ? 'card--reverse' : ''}`}>
              <img class="card__img" src={f.img} alt={f.title} loading="lazy" data-reveal={i % 2 === 1 ? 'right' : 'left'} />
              <div class="card__body" data-reveal>
                <span class="icon-badge icon-badge--lg"><Icon name={f.icon} size={30} /></span>
                <p class="eyebrow">{f.eyebrow}</p>
                <h2 class="h3 teal">{f.title}</h2>
                <p style="color:var(--gray-text)">{f.desc}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section--alt">
      <div class="container">
        <p class="eyebrow">Tarifs</p>
        <h2 class="h2">Roulez à votre <span class="teal">niveau</span> !</h2>
        <p class="lead measure" style="margin-top:.5rem">Prix par personne, en CHF. Plus on est nombreux, moins c'est cher.</p>

        <div style="overflow-x:auto; margin-top:2rem">
          <table class="price-table">
            <thead>
              <tr><th>Personnes</th><th>1/2 journée</th><th>Journée</th></tr>
            </thead>
            <tbody>
              {rows.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td></tr>)}
            </tbody>
          </table>
        </div>

        <ul class="icon-list" style="margin-top:1.75rem">
          <li><span class="icon-badge icon-badge--sm"><Icon name="bike" size={20} /></span><a href={pathFor('location', lang)} style="text-decoration:underline; text-underline-offset:2px">Location E-Bike et Vélos</a>&nbsp;: 125.- la journée</li>
          <li><span class="icon-badge icon-badge--sm"><Icon name="shield" size={20} /></span>Casque : <strong style="margin-left:.3rem">offert</strong></li>
        </ul>

        <div style="margin-top:2rem"><CtaButton href={SITE.whatsapp} label="C'est parti !" variant="dark" external /></div>
      </div>
    </section>

    <Reviews lang={lang} />


    <section class="section section--alt">
      <div class="container">
        <article class="card card--reverse">
          <img class="card__img" src={IMG.guideVideos} alt="Vidéos techniques VTT" loading="lazy" data-reveal="right" />
          <div class="card__body" data-reveal>
            <p class="eyebrow">Cours &amp; technique</p>
            <h2 class="h3">Le plaisir en VTT passe par la <span class="teal">maîtrise</span>.</h2>
            <p style="color:var(--gray-text)">Adulte ou enfant, nos <a href={pathFor('cours', lang)}>cours privés de VTT</a> vous font progresser à votre rythme avec un accompagnement personnalisé : position, virages, freinage, confiance. En attendant, une sélection de <a href="https://www.mobilesport.ch/vtt/mtb-f/" target="_blank" rel="noopener">vidéos techniques</a> pour affiner votre pilotage.</p>
            <CtaButton href={pathFor('cours', lang)} label="Découvrir les Cours Privés" variant="dark" />
          </div>
        </article>
      </div>
    </section>

    <section class="section container">
      <p class="eyebrow">Questions fréquentes</p>
      <h2 class="h2" style="margin-bottom:1.5rem">FAQ : guide VTT à <span class="teal">Verbier</span></h2>
      <div class="faq">
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <CrossLinks
      lang={lang}
      links={[
        { href: pathFor('location', lang), label: 'Location e-bike à Verbier' },
        { href: pathFor('cours', lang), label: 'Cours privés VTT, adultes et enfants' },
        { href: pathFor('itineraires', lang), label: 'VTT à Verbier : le guide complet' },
        { href: pathFor('entreprise', lang), label: "Sortie d'entreprise en e-bike" },
      ]}
    />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Layout>
