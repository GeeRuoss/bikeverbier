---
import Layout from '../../layouts/Layout.astro';
import CtaButton from '../../components/CtaButton.astro';
import CallLink from '../../components/CallLink.astro';
import CrossLinks from '../../components/CrossLinks.astro';
import Icon from '../../components/Icon.astro';
import Reviews from '../../components/Reviews.astro';
import { IMG } from '../../data/images';
import { SITE, pathFor } from '../../data/site';

const lang = 'en' as const;

// CHF prices, IDENTICAL to FR (do not reproduce the Framer auto-translation bug).
const rows = [
  ['1 person', '320.-', '550.-'],
  ['2 people', '195.-', '290.-'],
  ['3 people', '160.-', '220.-'],
  ['4 people', '120.-', '175.-'],
  ['5 people', '95.-', '145.-'],
  ['6 people', '80.-', '120.-'],
];

const features = [
  {
    img: IMG.cardGuide,
    icon: 'pin',
    eyebrow: 'Local guides',
    title: 'Born in Verbier, we know every trail',
    desc: "We don't follow a route on a map, we share the trails of our childhood. From secret singletracks to the panoramic descents of Valais, every ride is a real encounter with the land and its hidden spots.",
  },
  {
    img: IMG.welcome,
    icon: 'leaf',
    eyebrow: 'Respect & enjoyment',
    title: 'At your pace, respecting the mountain',
    desc: 'Beginner or seasoned rider, on an e-bike or enduro, we adapt the terrain and tempo to your level. We ride clean and respect the trails and nature, so the fun lasts, ride after ride.',
  },
  {
    img: IMG.guideGourmande,
    icon: 'utensils',
    eyebrow: 'Gourmet ride',
    title: 'Gourmet ride: we pedal, then we feast!',
    desc: "We take you along Verbier's most beautiful trails, then stop at a mountain hut or alpine restaurant to taste the local dishes. Valais platter, alpine cheese, rye bread: the Valais terroir is earned, and it tastes even better after the ride!",
  },
];

// Visible FAQ + FAQPage markup: the questions people actually ask Google and AI assistants.
const faq = [
  {
    q: 'How much does a mountain bike guide cost in Verbier?',
    a: 'From CHF 80 to 320 per person for a half day and from CHF 120 to 550 for a full day, depending on group size (1 to 6 people): the bigger the group, the cheaper it gets. Helmets are included and every tour is private and tailor-made.',
  },
  {
    q: 'Can I rent an e-bike or a mountain bike for the tour?',
    a: 'Yes. Rental costs CHF 125 per day: we book the right bike for you with our partner shops in Verbier and it is waiting for you at the start of the ride. All details are on our e-bike rental Verbier page.',
  },
  {
    q: 'What riding level do I need for a guided tour?',
    a: 'None. From complete beginner to seasoned rider, on an e-bike or an enduro bike, we adapt the route and the pace to your level. Families with children are welcome.',
  },
  {
    q: 'When is the mountain biking season in Verbier?',
    a: 'The season usually runs from May to October depending on snow conditions, with the lifts open in summer. With around 150 riding days a year, there is almost always a rideable trail: our guides know where.',
  },
  {
    q: 'What is the gourmet ride?',
    a: 'A mountain bike or e-bike tour that ends in a mountain hut or alpine restaurant: Valais platter, alpine cheese, rye bread. We pedal first, then feast on local Valais produce.',
  },
  {
    q: 'What languages do the guides speak?',
    a: 'Our guides speak English, French, Spanish and German. All of them were born in Verbier and are Swiss Cycling certified.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  lang={lang}
  routeKey="guide"
  title="Mountain Biking Guide in Verbier | E-bike & Enduro Tours with locals | Bike Verbier"
  description="The best mountain biking guide in Verbier: guided tours, gourmet rides with local Valais food tastings, private coaching. Guides born in Verbier, e-bike or enduro, all levels. Rental and organisation included."
  ogImage={IMG.heroGuide}
>
  <section class="hero">
    <img class="hero__bg" src={IMG.heroGuide} alt="Guided mountain bike tour in Verbier with a local guide" width="1920" height="1280" fetchpriority="high" />
    <div class="hero__inner container">
      <p class="eyebrow" style="color:#fff">Private guide · Gourmet hike</p>
      <h1 class="h1" data-wipe>Your mountain bike guide on the most beautiful <span class="teal">trails of Verbier</span>!</h1>
      <p class="lead">Enjoy the clean air of Verbier at your own pace, with local guides.</p>
      <div class="hero-actions"><CtaButton href={SITE.whatsapp} label="Let's get started!" variant="light" external /><CallLink /></div>
    </div>
  </section>

  <div class="sheet">
    <section class="section section--intro container center">
      <p class="eyebrow">Mountain biking guide Verbier</p>
      <h2 class="h2">The <span class="teal">locals'</span> Verbier, on two wheels</h2>
      <p class="lead measure" style="margin:1.25rem auto 0">
        Born and raised in Verbier, we know every trail in Valais, from secret paths to breathtaking descents. On an e-bike or enduro, for beginners and experts alike, we share our mountains with respect and enjoyment.
      </p>
      <p class="measure" style="margin:1rem auto 0; color:var(--gray-text)">
        Meet <a href={`${pathFor('contact', lang)}#guides`}>our Swiss Cycling certified guides</a> or plan your trip with our <a href={pathFor('itineraires', lang)}>guide to mountain biking in Verbier</a>.
      </p>
    </section>

    <section class="section container">
      <div class="cards">
        {
          features.map((f, i) => (
            <article class={`card ${i % 2 === 1 ? 'card--reverse' : ''}`}>
              <img class="card__img" src={f.img} alt={f.title} loading="lazy" data-reveal={i % 2 === 1 ? 'right' : 'left'} />
              <div class="card__body" data-reveal>
                <span class="icon-badge icon-badge--lg"><Icon name={f.icon} size={30} /></span>
                <p class="eyebrow">{f.eyebrow}</p>
                <h2 class="h3 teal">{f.title}</h2>
                <p style="color:var(--gray-text)">{f.desc}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section--alt">
      <div class="container">
        <p class="eyebrow">Prices</p>
        <h2 class="h2">Drive at your <span class="teal">level</span>!</h2>
        <p class="lead measure" style="margin-top:.5rem">Price per person, in CHF. The bigger the group, the cheaper.</p>

        <div style="overflow-x:auto; margin-top:2rem">
          <table class="price-table">
            <thead>
              <tr><th>People</th><th>Half-Day</th><th>Full Day</th></tr>
            </thead>
            <tbody>
              {rows.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td></tr>)}
            </tbody>
          </table>
        </div>

        <ul class="icon-list" style="margin-top:1.75rem">
          <li><span class="icon-badge icon-badge--sm"><Icon name="bike" size={20} /></span><a href={pathFor('location', lang)} style="text-decoration:underline; text-underline-offset:2px">E-Bike &amp; bike rental</a>: 125.- full day</li>
          <li><span class="icon-badge icon-badge--sm"><Icon name="shield" size={20} /></span>Helmet: <strong style="margin-left:.3rem">included</strong></li>
        </ul>

        <div style="margin-top:2rem"><CtaButton href={SITE.whatsapp} label="Let's get started!" variant="dark" external /></div>
      </div>
    </section>

    <Reviews lang={lang} />


    <section class="section section--alt">
      <div class="container">
        <article class="card card--reverse">
          <img class="card__img" src={IMG.guideVideos} alt="Technical mountain biking videos" loading="lazy" data-reveal="right" />
          <div class="card__body" data-reveal>
            <p class="eyebrow">Lessons &amp; technique</p>
            <h2 class="h3">The pleasure of mountain biking comes from <span class="teal">mastery</span>.</h2>
            <p style="color:var(--gray-text)">Adult or child, our <a href={pathFor('cours', lang)}>private MTB lessons</a> help you progress at your own pace with personalised coaching: position, cornering, braking, confidence. Meanwhile, a selection of useful <a href="https://www.mobilesport.ch/vtt/mtb-f/" target="_blank" rel="noopener">technical videos</a> to refine your riding skills.</p>
            <CtaButton href={pathFor('cours', lang)} label="Discover Private Lessons" variant="dark" />
          </div>
        </article>
      </div>
    </section>

    <section class="section container">
      <p class="eyebrow">Frequently asked questions</p>
      <h2 class="h2" style="margin-bottom:1.5rem">FAQ: mountain bike guide in <span class="teal">Verbier</span></h2>
      <div class="faq">
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <CrossLinks
      lang={lang}
      links={[
        { href: pathFor('location', lang), label: 'E-bike rental in Verbier' },
        { href: pathFor('cours', lang), label: 'Private MTB lessons, adults and kids' },
        { href: pathFor('itineraires', lang), label: 'Mountain biking in Verbier: the guide' },
        { href: pathFor('entreprise', lang), label: 'Corporate e-bike team building' },
      ]}
    />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Layout>
