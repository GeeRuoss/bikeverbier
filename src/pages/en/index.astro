---
import Layout from '../../layouts/Layout.astro';
import CtaButton from '../../components/CtaButton.astro';
import CallLink from '../../components/CallLink.astro';
import Icon from '../../components/Icon.astro';
import Reviews from '../../components/Reviews.astro';
import CrossLinks from '../../components/CrossLinks.astro';
import { IMG, PARTNERS } from '../../data/images';
import { pathFor } from '../../data/site';

const lang = 'en' as const;

const offers = [
  {
    img: IMG.cardEntreprise,
    alt: 'Group on a guided ride on a flower-lined trail above Verbier',
    eyebrow: 'May to October · turnkey',
    title: 'Teambuilding',
    items: ['Corporate outing on an E-bike', 'Exploration of local produce', 'Visit of local restaurateurs'],
    cta: 'Information and Prices',
    href: pathFor('entreprise', lang),
  },
  {
    img: IMG.cardGuide,
    alt: 'Guided MTB ride on a built trail in Verbier',
    eyebrow: 'From CHF 80 per person',
    title: 'Private Guide / Gourmet Hike',
    items: ['From beginner to expert', 'Ideal for families', 'On an E-bike or Enduro'],
    cta: 'Discover',
    href: pathFor('guide', lang),
  },
  {
    img: IMG.heroEbike,
    alt: 'Three e-bike riders above Verbier',
    eyebrow: 'All levels',
    title: 'E-bike Tours',
    items: ['Alpine paths of the Val de Bagnes', 'Gourmet ride to a mountain hut', 'From easy to sporty'],
    cta: 'Discover',
    href: pathFor('ebike', lang),
  },
  {
    img: IMG.cardSemaine,
    alt: 'Rider on a bermed turn during an MTB lesson in Verbier',
    eyebrow: 'Adults & kids',
    title: 'Private MTB Lessons',
    items: ['Position, cornering, braking', 'From beginner to confident rider', 'With an instructor born in Verbier'],
    cta: 'Discover',
    href: pathFor('cours', lang),
  },
  {
    img: IMG.cardNepal,
    alt: 'Rider carrying his bike in front of the Himalayan peaks, Nepal',
    eyebrow: 'Journey of a Lifetime',
    title: '10 Days of Enduro in Nepal',
    items: ['Local reception', 'Private shuttle', 'Domestic flights'],
    cta: 'Discover',
    href: pathFor('nepal', lang),
  },
];

// Counters: sources verbier4vallees.ch (500 km of MTB routes, summer 2026 lifts) and verbier.ch (mountain restaurants), checked on 22.09.2026.
const counters = [
  { n: 12, label: 'Mountain restaurants', icon: 'utensils' },
  { n: 500, label: 'km of MTB routes', icon: 'route' },
  { n: 23, label: 'Signposted enduro routes', icon: 'flag' },
  { n: 18, label: 'Lifts open in summer', icon: 'gondola' },
];
---

<Layout
  lang={lang}
  routeKey="home"
  title="Mountain Bike & E-bike Guides in Verbier | Tours, Rental, Lessons, Team Building | Bikeverbier.ch"
  description="Mountain bike and e-bike guides born in Verbier: guided tours, gourmet rides, private lessons, e-bike rental at CHF 125 per day, team building May to October."
  ogImage={IMG.ogHome}
  jsonLd={true}
>
  <section class="hero">
    <img class="hero__bg" src={IMG.heroHome} alt="Mountain biking down the trails of Verbier" width="1920" height="1280" fetchpriority="high" />
    <div class="hero__inner container">
      <p class="eyebrow" style="color:#fff">Mountain bike and e-bike guides in Verbier</p>
      <h1 class="h1" data-wipe>Discover the <span class="teal">hidden Verbier</span></h1>
      <p class="lead">Local mountain bike guides, e-bike and enduro tours: from remote trails to the flavours of Valais, let yourself be guided by locals born in Verbier.</p>
      <div class="hero-actions"><CtaButton href={pathFor('contact', lang)} label="Let's go!" variant="light" /><CallLink /></div>
    </div>
  </section>

  <div class="sheet">
    <section class="section container">
      <div class="center" style="margin-bottom:2.5rem">
        <p class="eyebrow">Our offers</p>
        <h2 class="h2">Guided MTB and e-bike tours in <span class="teal">Verbier</span></h2>
      </div>
      <div class="cards">
        {
          offers.map((o, i) => (
            <article class={`card ${i % 2 === 1 ? 'card--reverse' : ''}`} data-reveal>
              <img class="card__img" src={o.img} alt={o.alt} loading="lazy" />
              <div class="card__body">
                <p class="eyebrow">{o.eyebrow}</p>
                <h3 class="h3 teal">{o.title}</h3>
                <ul>{o.items.map((it) => <li>{it}</li>)}</ul>
                <CtaButton href={o.href} label={o.cta} variant="dark" />
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section--alt">
      <div class="container counters">
        {
          counters.map((c) => (
            <div data-reveal>
              <div class="counter__icon icon-badge"><Icon name={c.icon} size={26} /></div>
              <div class="counter__num"><span data-count={c.n}>{c.n}</span></div>
              <div class="counter__label">{c.label}</div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section container">
      <div class="card" data-reveal>
        <img class="card__img" src={IMG.welcome} alt="Bikeverbier guide in Verbier" loading="lazy" />
        <div class="card__body">
          <p class="eyebrow">Welcome</p>
          <h2 class="h2">Welcome to <span class="teal">Bikeverbier.ch</span>!</h2>
          <p class="lead">We are guides all born in Verbier, ready to introduce you to our local trails and traditions!</p>
          <p style="color:var(--gray-text)">Your local <a href={pathFor('guide', lang)}>mountain bike guide in Verbier</a>: e-bike and enduro outings, gourmet rides and <a href={pathFor('cours', lang)}>private lessons</a>, with <a href={pathFor('location', lang)}>e-bike rental</a> available for every tour. From the quieter trails of Valais to the finest mountain-top restaurants, we share our mountains with those who want to experience them differently. Planning your trip? Browse our <a href={pathFor('itineraires', lang)}>complete guide to mountain biking in Verbier</a>.</p>
          <CtaButton href={`${pathFor('contact', lang)}#guides`} label="Our Guides" variant="teal" />
        </div>
      </div>
    </section>

    <Reviews lang={lang} alt />

    <CrossLinks
      lang={lang}
      links={[
        { href: pathFor('ebike', lang), label: 'E-bike tours in Verbier' },
        { href: pathFor('itineraires', lang), label: 'Mountain biking in Verbier: trails, bike park, season' },
        { href: `${pathFor('itineraires', lang)}#bike-park`, label: 'Verbier bike park: how it works' },
        { href: pathFor('location', lang), label: 'E-bike and mountain bike rental in Verbier' },
        { href: pathFor('entreprise', lang), label: 'MTB and e-bike team building' },
        { href: pathFor('nepal', lang), label: 'Enduro trip to Nepal' },
      ]}
    />

    <section class="section">
      <div class="container">
        <p class="eyebrow center">Our partners</p>
        <div class="partners" style="margin-top:2.5rem">
          {PARTNERS.map((p) => <img src={p.src} alt={p.name} title={p.name} loading="lazy" />)}
        </div>
      </div>
    </section>
  </div>
</Layout>
