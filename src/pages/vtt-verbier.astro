---
// Page ressource « VTT à Verbier » : le guide complet par des locaux.
// Objectif SEO + GEO : capter les requêtes informationnelles (vtt verbier, verbier vtt,
// bike park verbier, saison) et donner aux IA une page riche en faits vérifiés à citer.
// Refonte du 22.09.2026 : section « Bike park de Verbier, mode d'emploi » (accès, saison,
// horaires, forfaits, pistes, règles), chiffres réalignés sur les sources officielles
// (verbier4vallees.ch, verbierbikepark.ch, verbier.ch), FAQ étendue. À rafraîchir chaque
// saison : dates, tarifs et pistes changent (les pages non mises à jour perdent leurs citations IA).
import Layout from '../layouts/Layout.astro';
import CtaButton from '../components/CtaButton.astro';
import CallLink from '../components/CallLink.astro';
import CrossLinks from '../components/CrossLinks.astro';
import Icon from '../components/Icon.astro';
import { IMG } from '../data/images';
import { pathFor } from '../data/site';

const lang = 'fr' as const;

const terrains = [
  {
    img: IMG.libreVttVerbier,
    alt: 'Vététiste sur un singletrack au-dessus de la vallée du Rhône, à Verbier',
    icon: 'mountain',
    eyebrow: 'Enduro & singletracks',
    title: 'Les sentiers au-dessus de la station',
    desc: "C'est le cœur du jeu à Verbier : singletracks à flanc de montagne, épingles, forêt, panoramas sur les Combins. 23 itinéraires enduro balisés, de La Chaux au Châble, avec plus de 1500 m de descente. Et c'est là que nos guides font la différence : les plus beaux sentiers ne sont pas sur les cartes.",
  },
  {
    img: IMG.heroHome,
    alt: 'VTT en descente sur les sentiers de Verbier',
    icon: 'gondola',
    eyebrow: 'Bike park',
    title: 'Le bike park de Verbier',
    desc: "Neuf pistes et 19 km de descente, de la verte d'apprentissage à la piste de course Tire's Fire, au départ de Médran, de La Chaux et de Savoleyres. Parfait pour progresser en enchaînant les runs. Le mode d'emploi est un peu plus bas.",
  },
  {
    img: IMG.guideGourmande,
    alt: 'Assiette valaisanne : viande séchée, fromage et pain de seigle',
    icon: 'utensils',
    eyebrow: 'E-bike & terroir',
    title: 'Les chemins d’alpage du Val de Bagnes',
    desc: "En e-bike, le Val de Bagnes s'ouvre à tous : chemins d'alpage, villages, cabanes et une douzaine de restaurants d'altitude pour l'assiette valaisanne et le fromage de Bagnes. C'est le terrain de notre rando gourmande.",
  },
];

const conseils = [
  { icon: 'sun', title: 'La saison', text: "Remontées ouvertes aux vélos de juin à fin octobre (bike park 2026 : du 4 juin au 25 octobre), sentiers praticables de mai à novembre selon l'enneigement. Juillet et août pour l'ambiance et toutes les installations ouvertes, septembre et octobre pour les couleurs et les sentiers tranquilles." },
  { icon: 'route', title: 'Le terrain de jeu', text: 'Environ 500 km de parcours VTT autour de Verbier et du Val de Bagnes, 23 itinéraires enduro balisés et 9 pistes de descente au bike park, au cœur du domaine des 4 Vallées.' },
  { icon: 'bike', title: 'Le matériel', text: "E-bike pour monter sans souffrir, enduro pour jouer dans les descentes. Location possible à 125.- la journée, casque offert, vélo réservé chez nos partenaires et prêt au départ. Borne de recharge e-VTT gratuite à Médran." },
  { icon: 'shield', title: 'La sécurité', text: 'Casque toujours, protections en descente (gants, genouillères, dorsale), et respect des randonneurs, prioritaires sur les sentiers partagés. On partage la montagne. En cas de doute sur un sentier, demandez à un local.' },
];

// Pistes du bike park de Verbier, saison 2026 (verbierbikepark.ch et verbier.ch, relevé le 22.09.2026).
const pistes = [
  { n: '09', nom: 'Tsenelle', color: 'green', niveau: 'Verte', type: "Apprentissage, flow · La Chaux, du 4 juil. au 21 sept.", km: '1,9 km', d: '187 m' },
  { n: '08', nom: 'Chôtatai', color: 'blue', niveau: 'Bleue', type: "Flow, 5 km jusqu’à La Tzoumaz · Savoleyres, du 4 juil. au 30 août et 3 week-ends de sept.", km: '5 km', d: '680 m' },
  { n: '02', nom: 'Tsopu', color: 'blue', niveau: 'Bleue', type: "Flow · Médran, du 4 juin au 25 oct.", km: '2,4 km', d: '389 m' },
  { n: '04', nom: 'Wouaiy', color: 'red', niveau: 'Rouge', type: "Flow et trail · Médran, du 4 juin au 25 oct.", km: '2,2 km', d: '529 m' },
  { n: '03', nom: 'Tû çuci', color: 'red', niveau: 'Rouge', type: "Freeride, sauts · Médran, du 4 juin au 25 oct.", km: '1,1 km', d: '527 m' },
  { n: '07', nom: 'Rôdze', color: 'red', niveau: 'Rouge', type: "Sauts, 65 modules · La Chaux, du 4 juil. au 21 sept.", km: '2,1 km', d: '307 m' },
  { n: '06', nom: 'Bortabitche', color: 'red', niveau: 'Rouge à noire', type: "Freeride, sauts · La Chaux, du 4 juil. au 21 sept.", km: '1,3 km', d: '227 m' },
  { n: '01', nom: "Tire's Fire", color: 'race', niveau: 'Compétition', type: "Piste de course, Coupe d’Europe DH · Médran, du 4 juin au 25 oct.", km: '2,3 km', d: '573 m' },
  { n: '05', nom: 'Woooohhh', color: 'black', niveau: 'Noire', type: "Technique · Médran, du 4 juin au 25 oct.", km: '0,6 km', d: '130 m' },
];

// Itinéraires enduro balisés (Verbier Bikepark, relevé le 22.09.2026). Niveau officiel : Débutant / Avancé / Expert.
const enduros = [
  { nom: "Ruinettes - Clambin - Le Châble", color: 'green', niveau: 'Débutant', type: "14 km, aucun sentier", km: "1743 m de descente", d: "374 m de montée" },
  { nom: "La Planie", color: 'green', niveau: 'Débutant', type: "10,5 km, aucun sentier", km: "452 m de descente", d: "537 m de montée" },
  { nom: "Verbier - Le Châble", color: 'green', niveau: 'Débutant', type: "6,4 km dont 1,2 km de sentier", km: "830 m de descente", d: "129 m de montée" },
  { nom: "La Côt - Bruson", color: 'green', niveau: 'Débutant', type: "7,2 km, aucun sentier", km: "867 m de descente", d: "293 m de montée" },
  { nom: "La Côt - Le Châble", color: 'green', niveau: 'Débutant', type: "8,2 km, aucun sentier", km: "993 m de descente", d: "271 m de montée" },
  { nom: "Croix de Cœur - La Tzoumaz", color: 'green', niveau: 'Débutant', type: "3,9 km dont 2,6 km de sentier", km: "646 m de descente", d: "0 m de montée" },
  { nom: "La Chaux - Schlérondes - Le Châble", color: 'red', niveau: 'Avancé', type: "7,7 km dont 6,2 km de sentier", km: "1576 m de descente", d: "248 m de montée" },
  { nom: "Fontanet - La Chaux", color: 'red', niveau: 'Avancé', type: "6 km dont 4,2 km de sentier", km: "522 m de descente", d: "285 m de montée" },
  { nom: "Larzai - Bruson", color: 'red', niveau: 'Avancé', type: "8,5 km dont 6,2 km de sentier", km: "1312 m de descente", d: "342 m de montée" },
  { nom: "Six Blanc - Lourtier", color: 'red', niveau: 'Avancé', type: "19,8 km dont 8,5 km de sentier", km: "1874 m de descente", d: "1181 m de montée" },
  { nom: "Cabane Mont-Fort - La Chaux - Lourtier", color: 'black', niveau: 'Expert', type: "7,8 km dont 6,8 km de sentier", km: "1449 m de descente", d: "85 m de montée" },
  { nom: "Col de Mille", color: 'black', niveau: 'Expert', type: "14,7 km dont 9,9 km de sentier", km: "1862 m de descente", d: "684 m de montée" },
  { nom: "Vallon d’Arby", color: 'black', niveau: 'Expert', type: "4,6 km dont 3,1 km de sentier", km: "669 m de descente", d: "212 m de montée" },
];

const chiffres = [
  { n: 1500, label: "m d'altitude à Verbier", icon: 'mountain' },
  { n: 500, label: "km de parcours VTT", icon: 'route' },
  { n: 23, label: "itinéraires enduro balisés", icon: 'flag' },
  { n: 9, label: "pistes au bike park", icon: 'gondola' },
];

const faq = [
  {
    q: 'Faut-il un guide pour faire du VTT à Verbier ?',
    a: "Ce n'est pas obligatoire, mais ça change tout : les plus beaux sentiers de Verbier ne sont pas balisés et un guide local vous emmène au bon endroit selon votre niveau, la météo et l'état des sentiers. Nos guides sont nés à Verbier et certifiés Swiss Cycling, dès 80 CHF par personne.",
  },
  {
    q: 'Quel est le meilleur itinéraire VTT à Verbier ?',
    a: "Tout dépend de votre niveau. Pour les panoramas, la descente depuis les hauts du domaine vers Le Châble, plus de 1500 m de dénivelé. Pour l'enduro, les singletracks au-dessus de la station. Pour une sortie plaisir en famille, les chemins d'alpage du Val de Bagnes en e-bike avec une pause dans un restaurant d'altitude.",
  },
  {
    q: 'Verbier convient-il aux débutants en VTT ?',
    a: "Oui. Grâce à l'e-bike et aux chemins doux du Val de Bagnes, un débutant profite dès la première sortie. Au bike park, la verte Tsenelle (du 4 juillet au 21 septembre) et la bleue Chôtatai (juillet et août) sont faites pour apprendre ; en juin et après le 21 septembre, on commence par la bleue Tsopu, depuis Médran. Nos sorties guidées et nos cours privés s'adaptent à tous les niveaux, familles et enfants compris.",
  },
  {
    q: 'Quand ouvre le bike park de Verbier ?',
    a: "En 2026, le bike park est ouvert du 4 juin au 25 octobre. La télécabine Verbier-Les Ruinettes tourne de 8 h 30 à 17 h du 27 juin au 21 septembre, puis de 9 h à 17 h jusqu'à fin octobre, avec des ouvertures partielles en juin. Les dates de chaque saison sont publiées par Téléverbier sur verbier4vallees.ch.",
  },
  {
    q: 'Combien coûte le forfait VTT au bike park de Verbier ?',
    a: "En 2026, le Pass Bike Verbier (Verbier, Bruson, La Tzoumaz) coûte 47.- la journée pour un adulte, 40.- pour un jeune et 24.- pour un enfant ; le Pass Bike 4 Vallées coûte 57.-. Les hôtes qui paient la taxe de séjour reçoivent le VIP Pass : avec lui, la journée bike Verbier coûte 24.- pour un adulte. Achat en ligne sur verbier4vallees.ch, avec 10 % de réduction dix jours à l'avance.",
  },
  {
    q: 'Peut-on monter son e-bike dans la télécabine de Médran ?',
    a: "Oui. Les cabines de dix places de la télécabine Médran-Les Ruinettes transportent les vélos, e-bikes compris, en six minutes de montée pour 666 m de dénivelé. Une borne de recharge gratuite pour e-VTT est installée à Médran.",
  },
  {
    q: 'Peut-on louer un e-bike ou un VTT à Verbier ?',
    a: 'Oui : 125 CHF la journée, casque offert. Nous réservons le vélo pour vous chez nos partenaires de Verbier et il vous attend au départ de votre sortie.',
  },
  {
    q: 'Combien coûte une sortie VTT guidée à Verbier ?',
    a: 'De 80 à 320 CHF par personne la demi-journée et de 120 à 550 CHF la journée selon la taille du groupe. Les cours privés et le voyage au Népal sont sur demande.',
  },
  {
    q: 'Comment venir à Verbier avec son vélo ?',
    a: "En voiture, Verbier est à 30 minutes de Martigny, 50 minutes de Sion, 1 h 20 de Lausanne et 2 h de Genève. En train, descendez au Châble (25 minutes depuis Martigny), puis la télécabine Le Châble-Verbier vous monte en une dizaine de minutes, vélo compris. Du 27 avril au 22 mai et du 26 au 30 octobre, elle est en révision : un bus la remplace.",
  },
  {
    q: "Verbier est-il une bonne destination VTT ?",
    a: "Oui, une des plus grandes de Suisse : 500 km de parcours, 23 itinéraires enduro balisés, un bike park de 9 pistes, 18 remontées ouvertes en été et une saison de juin à fin octobre. Le tout à 1500 m d'altitude, avec des descentes de plus de 1700 m jusqu'au Châble.",
  },
  {
    q: "Quels sont les meilleurs sentiers VTT de Verbier ?",
    a: "Pour débuter : Ruinettes - Clambin - Le Châble, 14 km de routes forestières et 1743 m de descente, ou La Planie, à plat à 2200 m. Pour l'enduro, niveau avancé : La Chaux - Schlérondes, Larzai - Bruson et Six Blanc - Lourtier. Pour les experts : Cabane Mont-Fort - La Chaux - Lourtier, le Col de Mille (1862 m de descente) et le Vallon d'Arby. Nos guides y ajoutent les sentiers qui ne sont pas balisés.",
  },
  {
    q: "Peut-on faire du vélo de route à Verbier ?",
    a: "Oui. La montée Le Châble - Verbier (8,8 km à 7,5 %) a été l'arrivée d'une étape du Tour de France 2009, et la Croix de Cœur (15,5 km à 8,7 %, sommet à 2174 m) a vu passer le Giro 2023. Col des Planches, Champex-Lac, Mauvoisin et Grand-Saint-Bernard complètent le menu, et le Tour des Stations part du Châble fin août. On est guides VTT et e-bike, pas guides route, mais nos partenaires Backside et Médran Sports louent des vélos de route.",
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  lang={lang}
  routeKey="itineraires"
  title="VTT à Verbier : le Guide Complet des Locaux | Sentiers, Bike Park, Saison, Forfaits"
  description="VTT à Verbier par des guides nés ici : 500 km de parcours, 23 enduros balisés, le bike park expliqué (9 pistes, forfaits 2026), saison et conseils."
  ogImage={IMG.heroVtt}
>
  <section class="hero">
    <img class="hero__bg" src={IMG.heroVtt} alt="VTT sur un singletrack au-dessus de Verbier, Valais" width="1920" height="1280" fetchpriority="high" />
    <div class="hero__inner container">
      <p class="eyebrow" style="color:#fff">Le guide des locaux</p>
      <h1 class="h1" data-wipe>Le VTT à Verbier, raconté par <span class="teal">ceux qui y sont nés</span></h1>
      <p class="lead">Sentiers, bike park, saison, forfaits, tarifs : tout ce qu'il faut savoir avant de rouler ici.</p>
      <div class="hero-actions"><CtaButton href={pathFor('guide', lang)} label="Rouler avec un guide" variant="light" /><CallLink /></div>
    </div>
  </section>

  <div class="sheet">
    <section class="section section--intro container center">
      <p class="eyebrow">Verbier, Val de Bagnes, Valais</p>
      <h2 class="h2">Une des plus grandes destinations VTT <span class="teal">de Suisse</span></h2>
      <p class="lead measure" style="margin:1.25rem auto 0">
        Verbier, à 1500 m d'altitude dans le Val de Bagnes en Valais, c'est environ 500 km de parcours VTT au cœur du domaine des 4 Vallées, 23 itinéraires enduro balisés, un bike park de 9 pistes desservi par la télécabine de Médran et une douzaine de restaurants d'altitude. Les remontées accueillent les vélos de juin à fin octobre.
      </p>
      <p class="measure" style="margin:1rem auto 0; color:var(--gray-text)">
        Cette page est notre guide local : ce qu'on répond quand on nous demande où, quand et comment rouler à Verbier. Pour le vivre sur le terrain, il y a nos <a href={pathFor('guide', lang)}>sorties guidées</a>, nos <a href={pathFor('cours', lang)}>cours privés</a> et la <a href={pathFor('location', lang)}>location d'e-bike</a>.
      </p>
    </section>

    <section class="section section--alt" style="padding-block:clamp(2.5rem,5vw,4rem)">
      <div class="container counters">
        {chiffres.map((c) => (
          <div data-reveal>
            <div class="counter__icon icon-badge"><Icon name={c.icon} size={26} /></div>
            <div class="counter__num"><span data-count={c.n}>{c.n}</span></div>
            <div class="counter__label">{c.label}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="section container">
      <div class="center" style="margin-bottom:2.5rem">
        <p class="eyebrow">Les terrains</p>
        <h2 class="h2">Trois façons de rouler à <span class="teal">Verbier</span></h2>
      </div>
      <div class="cards">
        {
          terrains.map((f, i) => (
            <article class={`card ${i % 2 === 1 ? 'card--reverse' : ''}`}>
              <img class="card__img" src={f.img} alt={f.alt} loading="lazy" data-reveal={i % 2 === 1 ? 'right' : 'left'} />
              <div class="card__body" data-reveal>
                <span class="icon-badge icon-badge--lg"><Icon name={f.icon} size={30} /></span>
                <p class="eyebrow">{f.eyebrow}</p>
                <h3 class="h3 teal">{f.title}</h3>
                <p style="color:var(--gray-text)">{f.desc}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section--alt" id="bike-park">
      <div class="container">
        <p class="eyebrow">Mode d'emploi</p>
        <h2 class="h2">Le bike park de Verbier, <span class="teal">expliqué par des locaux</span></h2>
        <p class="lead measure" style="margin-top:.75rem">
          Neuf pistes, 19 km de descente, trois départs : Médran, La Chaux et Savoleyres. Comment ça marche, avec les chiffres 2026.
        </p>
        <figure class="figure" data-reveal>
          <img src={IMG.libreRuinettes} alt="Les Ruinettes et leurs sentiers au-dessus de Verbier, en été" width="1440" height="960" loading="lazy" />
        </figure>

        <div class="infobox-grid">
          <div class="infobox" data-reveal>
            <span class="icon-badge icon-badge--sm"><Icon name="gondola" size={20} /></span>
            <h3 style="margin-top:.75rem">Accès</h3>
            <p style="color:var(--gray-text)">Départ à Médran, en plein centre de Verbier. La télécabine Médran-Les Ruinettes (cabines de dix places, vélos à l'intérieur) monte de 1531 m à 2198 m en six minutes. Le télésiège Chaux Express ajoute 275 m pour les pistes du haut. Borne de recharge e-VTT gratuite à Médran. Chôtatai part de Savoleyres, au-dessus de La Tzoumaz.</p>
          </div>
          <div class="infobox" data-reveal>
            <span class="icon-badge icon-badge--sm"><Icon name="sun" size={20} /></span>
            <h3 style="margin-top:.75rem">Saison et horaires 2026</h3>
            <p style="color:var(--gray-text)">Bike park ouvert du 4 juin au 25 octobre. Verbier-Les Ruinettes de 8 h 30 à 17 h du 27 juin au 21 septembre, puis de 9 h à 17 h jusqu'au 25 octobre ; en juin, seulement du 4 au 7, les 13 et 14 et du 20 au 26. Les pistes du haut (Ruinettes-Fontanet et La Chaux-Fontanet) tournent du 4 juillet au 21 septembre. Chôtatai, depuis Savoleyres : du 4 juillet au 30 août, plus quelques week-ends de septembre.</p>
          </div>
          <div class="infobox" data-reveal>
            <span class="icon-badge icon-badge--sm"><Icon name="calendar" size={20} /></span>
            <h3 style="margin-top:.75rem">Forfaits 2026</h3>
            <p style="color:var(--gray-text)">Pass Bike Verbier (Verbier, Bruson, La Tzoumaz) : 47.- la journée adulte, 40.- jeune, 24.- enfant. Pass Bike 4 Vallées : 57.-. Avec le VIP Pass des hôtes, la journée Verbier coûte 24.- adulte. Réduction de 10 % en ligne dix jours à l'avance, 15 % dès 15 personnes. Télécabine Le Châble-Verbier : 6.40 le trajet.</p>
          </div>
          <div class="infobox" data-reveal>
            <span class="icon-badge icon-badge--sm"><Icon name="shield" size={20} /></span>
            <h3 style="margin-top:.75rem">Équipement et règles</h3>
            <p style="color:var(--gray-text)">Casque, gants, genouillères et dorsale fortement recommandés, casque intégral en descente. Les piétons sont prioritaires sur les sentiers partagés : on ralentit et on s'arrête avant chaque croisement. On reste sur les pistes balisées, on referme les barrières des alpages, on ramasse ses déchets.</p>
          </div>
        </div>

        <h3 class="h3" style="margin-top:3rem">Les neuf pistes, de la verte à la <span class="teal">compétition</span></h3>
        <ul class="trails">
          {pistes.map((p) => (
            <li class={`trail trail--${p.color}`} data-reveal>
              <span class="trail__dot" aria-hidden="true"></span>
              <span class="trail__name">{p.nom}</span>
              <span class="trail__level">{p.niveau}</span>
              <span class="trail__type">{p.type}</span>
              <span class="trail__num">{p.km}</span>
              <span class="trail__num">{p.d}</span>
            </li>
          ))}
        </ul>
        <p class="measure" style="margin-top:1.25rem; color:var(--gray-text)">
          Débutant ? Du 4 juillet au 21 septembre, Tsenelle d'abord (La Chaux), puis Chôtatai en juillet et en août, cinq kilomètres de flow de Savoleyres à La Tzoumaz. En juin et après le 21 septembre, seules les pistes de Médran tournent : commencez par Tsopu, idéalement avec un cours. Confirmé ? Wouaiy et Rôdze, 65 sauts. Tire's Fire, c'est la piste de course de la Coupe d'Europe de descente. Pump track, skill park et dirt park au pied des pistes.
        </p>
        <p class="measure" style="margin-top:1rem; color:var(--gray-text)">
          Envie d'apprendre dans le bon ordre ? Nos <a href={pathFor('cours', lang)}>cours privés</a> commencent sur les vertes et les bleues, adultes et enfants. Pour l'enduro hors du park, un <a href={pathFor('guide', lang)}>guide né à Verbier</a> connaît les 23 itinéraires balisés, et ceux qui ne le sont pas.
        </p>
        <p class="measure" style="margin-top:1rem; color:var(--gray-text)">
          Le rendez-vous de l'été : le Verbier Bike Festival, du 13 au 16 août 2026, du 12 au 15 août 2027. Chiffres relevés le 22 septembre 2026 sur <a href="https://www.verbierbikepark.ch/" target="_blank" rel="noopener">verbierbikepark.ch</a> et <a href="https://verbier4vallees.ch/" target="_blank" rel="noopener">verbier4vallees.ch</a> : vérifiez les horaires du jour avant de monter.
        </p>
      </div>
    </section>

    <section class="section container" id="enduro">
      <p class="eyebrow">Enduro balisé</p>
      <h2 class="h2">Les itinéraires enduro <span class="teal">officiels</span></h2>
      <p class="lead measure" style="margin-top:.75rem">Vingt-trois itinéraires balisés par Verbier Bikepark, du Châble aux cabanes. Voici les principaux, avec le niveau, la descente et la montée : de quoi choisir sa journée. Un guide né ici y ajoute les variantes qui ne sont pas balisées.</p>
      <ul class="trails">
        {enduros.map((p) => (
          <li class={`trail trail--${p.color}`} data-reveal>
            <span class="trail__dot" aria-hidden="true"></span>
            <span class="trail__name">{p.nom}</span>
            <span class="trail__level">{p.niveau}</span>
            <span class="trail__type">{p.type}</span>
            <span class="trail__num">{p.km}</span>
            <span class="trail__num">{p.d}</span>
          </li>
        ))}
      </ul>
